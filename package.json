{
  "name": "safar-travel-platform",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "tsx prisma/seed.ts",
    "db:seed:catalogue": "tsx prisma/seed-safar-catalogue.ts",
    "db:check": "tsx scripts/check-db.ts",
    "admin:hash": "node scripts/reset-admin-password.cjs",
    "admin:check": "node scripts/check-admin-config.cjs"
  },
  "dependencies": {
    "@google/genai": "^2.30.0",
    "@prisma/adapter-pg": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "@tavily/core": "^0.7.14",
    "@types/leaflet": "^1.9.22",
    "bcryptjs": "^3.0.3",
    "dotenv": "^18.0.8",
    "leaflet": "^1.9.4",
    "lucide-react": "^1.59.0",
    "next": "16.4.2",
    "pg": "^8.23.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^20",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.2",
    "prisma": "^7.10.1",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5"
  },
  "allowScripts": {
    "unrs-resolver@1.12.2": true,
    "@google/genai@2.30.0": true,
    "protobufjs@7.6.6": true,
    "prisma@7.10.1": true,
    "@prisma/engines@7.10.1": true,
    "esbuild@0.28.2": true
  },
  "description": "Safar - AI-assisted travel planning and booking platform built with Next.js, Prisma and PostgreSQL.",
