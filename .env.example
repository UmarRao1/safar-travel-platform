# Copy this file to `.env` and fill in your own values. NEVER commit `.env`.

# --- Database (PostgreSQL) ---
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/safar?schema=public"

# --- AI trip planner ---
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
TAVILY_API_KEY=

# --- Admin login ---
# Run `npm run admin:hash` to generate ADMIN_PASSWORD_HASH (bcrypt).
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD_HASH=
# Random string, at least 32 characters (e.g. `openssl rand -base64 48`).
ADMIN_SESSION_SECRET=

# --- Cost estimate assumptions (PKR, illustrative planning allowances) ---
SAFAR_RATE_ACCOMMODATION_PER_PERSON_NIGHT=2500
SAFAR_RATE_MEALS_PER_PERSON_DAY=1800
SAFAR_RATE_LOCAL_TRANSPORT_PER_PERSON_DAY=1200
SAFAR_RATE_ACTIVITIES_PER_PERSON_DAY=800
SAFAR_CONTINGENCY_PERCENT=10
